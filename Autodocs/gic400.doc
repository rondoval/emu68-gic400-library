gic400.library/DisableInt                             gic400.library/DisableInt

   NAME
	DisableInt -- disable forwarding of an interrupt

   SYNOPSIS
	error = DisableInt( irq )
	d0                  d0

	LONG DisableInt(ULONG);

   FUNCTION
	Clears the enable bit of an interrupt in the Distributor.
	Priority, trigger mode and routing are left untouched, and a
	registered server stays registered.

   INPUTS
	irq             The interrupt ID. SPIs start at 32; the valid range is
	                0 up to the number of IDs reported by
	                GetControllerInfo() (maxIrqs, at most 1020).

   RESULTS
	error           0 on success, GIC400_ERR_INVALID_IRQ if irq is out of
	                range.

   NOTE
	As of V1.3 a failure returns one of the distinct negative GIC400_ERR_*
	codes, as a LONG. Prior to V1.3 every failure returned -1, whatever the
	cause, and the result was a ULONG.

   SEE ALSO
	gic400.library/EnableInt()

gic400.library/EnableInt                               gic400.library/EnableInt

   NAME
	EnableInt -- enable forwarding of an interrupt

   SYNOPSIS
	error = EnableInt( irq )
	d0                 d0

	LONG EnableInt(ULONG);

   FUNCTION
	Sets the enable bit of an interrupt in the Distributor.
	Priority, trigger mode and routing are left untouched.

   INPUTS
	irq             The interrupt ID. SPIs start at 32; the valid range is
	                0 up to the number of IDs reported by
	                GetControllerInfo() (maxIrqs, at most 1020).

   RESULTS
	error           0 on success, GIC400_ERR_INVALID_IRQ if irq is out of
	                range.

   NOTE
	An interrupt with a server installed by AddIntServerEx() is
	already enabled.

	As of V1.3 a failure returns one of the distinct negative GIC400_ERR_*
	codes, as a LONG. Prior to V1.3 every failure returned -1, whatever the
	cause, and the result was a ULONG.

   SEE ALSO
	gic400.library/DisableInt()

gic400.library/GetControllerInfo               gic400.library/GetControllerInfo

   NAME
	GetControllerInfo -- get identification and capabilities of the controller

   SYNOPSIS
	error = GetControllerInfo( info )
	d0                         a1

	LONG GetControllerInfo(struct GICInfo *);

   FUNCTION
	Fills a GICInfo structure (libraries/gic400.h) from the
	Distributor and CPU interface identification registers:

	distributorIIDR: GICD_IIDR.

	distributorTyper: GICD_TYPER.

	cpuInterfaceIIDR: GICC_IIDR.

	maxIrqs: number of interrupt IDs, capped at 1020.

	cpuCount: number of CPU interfaces.

	securityExtensions: 1 if the security extensions are
	implemented.

	lspiCount: number of lockable SPIs.

   INPUTS
	info            The structure to fill.

   RESULTS
	error           0 on success, GIC400_ERR_INVALID_ARGUMENT if info is
	                NULL.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/gic400.h>

	struct Library *GIC400_Base;

	if (GIC400_Base = OpenLibrary("gic400.library", 1))
	{
	    struct GICInfo info;

	    if (GetControllerInfo(&info) == 0)
	        Printf("%ld interrupts, %ld CPU(s)\n", info.maxIrqs, (ULONG)info.cpuCount);
	    CloseLibrary(GIC400_Base);
	}

   NOTE
	As of V1.3 a failure returns one of the distinct negative GIC400_ERR_*
	codes, as a LONG. Prior to V1.3 every failure returned -1, whatever the
	cause, and the result was a ULONG.

   SEE ALSO
	gic400.library/GetIntStatus()

gic400.library/GetHighestPending               gic400.library/GetHighestPending

   NAME
	GetHighestPending -- get the highest priority pending interrupt

   SYNOPSIS
	irq = GetHighestPending()
	d0

	LONG GetHighestPending(VOID);

   FUNCTION
	Reads the highest priority pending interrupt register of the CPU
	interface, without acknowledging the interrupt.

   RESULTS
	irq             The interrupt ID (low 10 bits of the register; 1023
	                when nothing is pending, per the GICv2 specification),
	                or a negative GIC400_ERR_* code.

   NOTE
	As of V1.3 a failure returns one of the distinct negative GIC400_ERR_*
	codes, as a LONG. Prior to V1.3 every failure returned -1, whatever the
	cause, and the result was a ULONG.

   SEE ALSO
	gic400.library/GetRunningPriority()

